{
  "name": "@omnypro/omnypotent",
  "version": "0.3.0",
  "license": "MIT",
  "description": "Colors and type for the Omnyist brand, with a Storybook reference.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnypro/omnypotent.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./hurme.css": "./dist/hurme.css",
    "./themes/*": "./dist/themes/*",
    "./tokens.json": "./dist/tokens.json",
    "./fonts.json": "./dist/fonts.json",
    "./fonts/*": "./dist/fonts/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "sketch": "bun scripts/sketch.ts",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "storybook": "bun run build && storybook dev -p 6006",
    "build-storybook": "bun run build && storybook build"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/html-vite": "^10.6.5",
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "storybook": "^10.6.5",
    "style-dictionary": "^5.7.1",
    "typescript": "^7.0.2"
  }
}
