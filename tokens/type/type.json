{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": "\"Space Grotesk Variable\", ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "$value": "\"Space Mono\", ui-monospace, monospace"
      }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    }
  }
}
